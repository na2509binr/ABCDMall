<script>
    // Số lượng ghế và sơ đồ ghế xem phim
    var totalSeats = 12;
    var arrCell = ["A", "B", "C", "D", "E", "F", "G", "H"];
    var selectedSeats = [];

    // Tạo sơ đồ ghế xem phim
    var seatMapElement = document.getElementById("seatMap");
    for (var i = 0; i < arrCell.length; i++) {
        const element = arrCell[i];
        if (i == arrCell.length - 1) {
            var divCouple = document.createElement("div");
            divCouple.className = "divCouple";
            for (var j = 1; j <= (totalSeats / 2); j++) {
                // var wid = 63;
                var seatElement = document.createElement("div");
                var paragraphElement = document.createElement("p");
                // seatElement.style.width = (wid+j).toString() + "px";
                // seatElement.style.width = "63px";
                paragraphElement.className = "nameSeatCouple";
                seatElement.className = "seatCouple";
                paragraphElement.textContent = element + j;
                seatElement.addEventListener("click", function () {
                    // Xử lý sự kiện khi ghế được chọn
                    this.classList.toggle("selected");
                    var seatNumber = parseInt(this.textContent);
                    if (selectedSeats.includes(seatNumber)) {
                        selectedSeats = selectedSeats.filter(function (seat) {
                            return seat !== seatNumber;
                        });
                    } else {
                        selectedSeats.push(seatNumber);
                    }
                });
                seatElement.appendChild(paragraphElement);
                divCouple.appendChild(seatElement);
            }
            seatMapElement.appendChild(divCouple);
            var brElement = document.createElement("br");
            seatMapElement.appendChild(brElement);
        } else {
            for (var j = 1; j <= totalSeats; j++) {
                // const element = arrCell[i];

                var seatElement = document.createElement("div");
                var paragraphElement = document.createElement("p");
                paragraphElement.className = "nameSeat";
                seatElement.className = "seat";
                paragraphElement.textContent = element + j;
                seatElement.addEventListener("click", function () {
                    // Xử lý sự kiện khi ghế được chọn
                    this.classList.toggle("selected");
                    var seatNumber = parseInt(this.textContent);
                    if (selectedSeats.includes(seatNumber)) {
                        selectedSeats = selectedSeats.filter(function (seat) {
                            return seat !== seatNumber;
                        });
                    } else {
                        selectedSeats.push(seatNumber);
                    }
                });
                seatElement.appendChild(paragraphElement);
                seatMapElement.appendChild(seatElement);
            }
            var brElement = document.createElement("br");
            seatMapElement.appendChild(brElement);
        }
    }
    var submitButton = document.getElementById("submitButton");
    submitButton.addEventListener("click", function () {
        if (selectedSeats.length > 0) {
            alert("Bạn đã chọn ghế: " + selectedSeats.join(", "));
        } else {
            alert("Vui lòng chọn ít nhất một ghế.");
        }
    });
</script>
